@startuml deployment-diagram
skinparam nodeBackgroundColor #f5f5f5
skinparam nodeBorderColor #555555
skinparam artifactBackgroundColor #fafafa
skinparam artifactBorderColor #777777
skinparam databaseBackgroundColor #e3f2fd
skinparam databaseBorderColor #1565c0
skinparam backgroundColor #ffffff
skinparam defaultFontSize 10

title Yóbbu — Deployment Diagram\n(local development and demo — Docker Compose)

node "Developer machine / Demo host" {

  node "Docker Compose" {

    frame "Frontends" #e8f5e9 {
      artifact "customer-app :3001" as CA
      artifact "courier-app :3002" as CouA
      artifact "operator-app :3003" as OA
      artifact "simulator" as SIM
    }

    frame "Backend Services" #fff8e1 {
      artifact "gateway :8080" as GW
      artifact "order :8081" as ORDER
      artifact "dispatch :8082" as DISPATCH
      artifact "tracking :8083" as TRACKING
      artifact "payment :8084" as PAYMENT
      artifact "notification :8085" as NOTIF
    }

    frame "Infrastructure" #e8eaf6 {
      database "postgres :5432" as PG
      artifact "kafka :9092\n+ zookeeper :2181" as KAFKA
      artifact "keycloak :8180" as KC
    }
  }
}

' Clients → gateway
CA --> GW
CouA --> GW
OA --> GW
SIM --> GW

' Gateway → services
GW --> ORDER
GW --> DISPATCH
GW --> TRACKING
GW --> KC : key fetch

' Services → infra
ORDER --> PG
ORDER --> KAFKA
DISPATCH --> PG
DISPATCH --> KAFKA
TRACKING --> PG
TRACKING --> KAFKA
PAYMENT --> PG
PAYMENT --> KAFKA
NOTIF --> PG
NOTIF --> KAFKA

note as DockerNote
  One command: docker compose up (C-02)
  Compose profiles enable starting subsets
  (e.g. only order + dispatch for early dev).
  Startup time and memory measured in phase 0.4
  (NFR-10, A-01, R-02).
  Production deployment (Kubernetes + Helm
  or Kustomize): phase 3.
end note
@enduml
