#!/bin/sh
# Gradle start up script for UN*X.
# Generated by Gradle; run 'make init' once to add gradle-wrapper.jar (binary, not committed).

app_path=$0
while
    APP_HOME=${app_path%"${app_path##*/}"}
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
      /*)   app_path=$link ;;
      *)    app_path=$APP_HOME$link ;;
    esac
done
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit
APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'
MAX_FD=maximum

warn () { echo "$*"; }
die  () { echo; echo "$*"; echo; exit 1; }

cygwin=false; msys=false; darwin=false; nonstop=false
case "$( uname )" in
  CYGWIN* )        cygwin=true  ;;
  Darwin* )        darwin=true  ;;
  MSYS* | MINGW* ) msys=true    ;;
  NONSTOP* )       nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
    die "ERROR: gradle-wrapper.jar not found.
Run 'make init' (requires Gradle 8.10.2) to generate it:
  cd services && gradle wrapper --gradle-version 8.10.2
Or build via Docker: docker compose build <service>"
fi

if [ -n "$JAVA_HOME" ]; then
    JAVACMD=$JAVA_HOME/bin/java
    [ ! -x "$JAVACMD" ] && die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME"
else
    JAVACMD=java
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command found in PATH."
fi

if ! "$cygwin" && ! "$darwin" && ! "$nonstop"; then
    case $MAX_FD in max*) MAX_FD=$( ulimit -H -n ) || warn "Could not query max FD limit" ;; esac
    case $MAX_FD in ''|soft) ;; *) ulimit -n "$MAX_FD" || warn "Could not set max FD limit" ;; esac
fi

eval set -- $DEFAULT_JVM_OPTS '"$JAVA_OPTS"' '"$GRADLE_OPTS"' \
    '"-Dorg.gradle.appname=$APP_BASE_NAME"' \
    -classpath '"$CLASSPATH"' \
    org.gradle.wrapper.GradleWrapperMain '"$@"'

exec "$JAVACMD" "$@"
